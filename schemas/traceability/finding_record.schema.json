{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legal-verification-system:schema.finding_record",
  "artifact_id": "schema.finding_record",
  "artifact_version": "0.1.0",
  "artifact_kind": "json_schema",
  "projection_status": "ACTIVE_PROJECTION",
  "normative_owners": [
    {
      "document": "GOVERNANCE/TRACEABILITY_RECORD_v1_v0.6.md",
      "version": "v0.6",
      "sections": [
        "§§15–16"
      ],
      "role": "semantic_owner"
    }
  ],
  "x_trace_object_type": "FINDING",
  "x_id_field": "finding_id",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^FND\\-[^\\s]+$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC\\-[^\\s]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVD\\-[^\\s]+$"
      },
      "uniqueItems": true
    },
    "analysis_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "evidence_bound_ai_proposed",
        "human_verified"
      ]
    },
    "related_requirement": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^REQ\\-[^\\s]+$"
    },
    "related_output": {
      "type": "string",
      "pattern": "^OUT\\-[^\\s]+$"
    },
    "data_class_event_references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DCE\\-[^\\s]+$"
      },
      "uniqueItems": true
    },
    "verification_scope_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^VSR\\-[^\\s]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "finding_id",
    "statement",
    "source_ids",
    "evidence_ids",
    "analysis_interpretation",
    "verification_level",
    "related_output"
  ]
}
