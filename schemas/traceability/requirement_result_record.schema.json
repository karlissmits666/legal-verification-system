{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legal-verification-system:schema.requirement_result_record",
  "artifact_id": "schema.requirement_result_record",
  "artifact_version": "0.1.0",
  "artifact_kind": "json_schema",
  "projection_status": "ACTIVE_PROJECTION",
  "normative_owners": [
    {
      "document": "GOVERNANCE/TRACEABILITY_RECORD_v1_v0.6.md",
      "version": "v0.6",
      "sections": [
        "§§22–29"
      ],
      "role": "semantic_owner"
    },
    {
      "document": "GOVERNANCE/PROFESSIONAL_SCOPE_v1.4.md",
      "version": "1.4",
      "sections": [
        "§§16",
        "18",
        "30"
      ],
      "role": "dependency"
    },
    {
      "document": "GOVERNANCE/VERIFICATION_PROTOCOL_v1.md",
      "version": "v0.5",
      "sections": [
        "§§6–15"
      ],
      "role": "dependency"
    }
  ],
  "x_trace_object_type": "REQUIREMENT",
  "x_id_field": "requirement_id",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ\\-[^\\s]+$"
    },
    "requirement_level": {
      "enum": [
        "mandatory_external",
        "mandatory_internal",
        "negotiable",
        null
      ]
    },
    "governance_status": {
      "enum": [
        "unclassified",
        null
      ]
    },
    "requirement_type": {
      "type": "string",
      "enum": [
        "positive",
        "negative"
      ]
    },
    "requirement_status": {
      "type": "string",
      "enum": [
        "izpildits",
        "nav_izpildits",
        "nav_pieradits"
      ]
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "evidence_bound_ai_proposed",
        "human_verified"
      ]
    },
    "requirement_source": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVD\\-[^\\s]+$"
      },
      "uniqueItems": true
    },
    "analysis_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "data_class_event_references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DCE\\-[^\\s]+$"
      },
      "uniqueItems": true
    },
    "scenario_only": {
      "type": "boolean"
    },
    "classification_basis_references": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "urn:legal-verification-system:schema.trace_object_reference"
          },
          {
            "properties": {
              "trace_object_type": {
                "enum": [
                  "legal_classification_assessment",
                  "human_decision"
                ]
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "classification_basis_current": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "superseded_by_result_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^REQ\\-[^\\s]+$"
    }
  },
  "required": [
    "requirement_id",
    "requirement_level",
    "governance_status",
    "requirement_type",
    "requirement_status",
    "verification_level",
    "requirement_source",
    "evidence_ids",
    "analysis_interpretation",
    "scenario_only"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "governance_status": {
              "const": "unclassified"
            },
            "requirement_level": {
              "type": "null"
            }
          },
          "required": [
            "governance_status",
            "requirement_level"
          ]
        },
        {
          "properties": {
            "governance_status": {
              "type": "null"
            },
            "requirement_level": {
              "enum": [
                "mandatory_external",
                "mandatory_internal",
                "negotiable"
              ]
            }
          },
          "required": [
            "governance_status",
            "requirement_level"
          ]
        }
      ]
    }
  ]
}
